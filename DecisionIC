#core.proto

syntax = "proto3";

package decisionintelligence.core.v1;

import "google/protobuf/struct.proto";

// Decision Intelligence Framework v1.2 - Core Specification, section 1.7.
// Same 3 methods as the REST API (api/main.py) - both transports call into
// the same application layer, see grpc/server.py.

service DecisionIntelligenceCore {
rpc UpdateMetric (UpdateMetricRequest) returns (UpdateMetricResponse);
rpc GetScoreboard (GetScoreboardRequest) returns (ScoreboardState);
rpc GetMerkleProof (GetMerkleProofRequest) returns (MerkleProof);
}

message UpdateMetricRequest {
string decision_id = 1;
string metric_name = 2;
bytes value = 3;              // JSON-encoded, value type is metric-specific
string idempotency_key = 4;
repeated string evidence_refs = 5;
string proposed_by = 6;
// JsonValue on the Python side (domain/events.py, domain/models.py):
// map<string,string> cannot carry that (no nesting, no non-string values),
// so this is google.protobuf.Struct, protobuf's actual JSON-object
// equivalent. Still opaque - Core never parses it either way (section 1.4).
google.protobuf.Struct runtime_context = 7;
}

message UpdateMetricResponse {
enum Status {
STATUS_UNSPECIFIED = 0;
ACCEPTED = 1;
DUPLICATE_IGNORED = 2;
REJECTED_MISSING_EVIDENCE = 3;
}
Status status = 1;
string leaf_hash = 2;  // empty unless status == ACCEPTED
}

message GetScoreboardRequest {
string decision_id = 1;
}

enum TrustScoreStatus {
TRUST_SCORE_STATUS_UNSPECIFIED = 0;
INSUFFICIENT_DATA = 1;  // I4 - never fabricate a score from missing data
}

message MetricEntry {
string metric_name = 1;
bytes value = 2;
repeated string evidence_refs = 3;
int64 committed_at_unix_ms = 4;
string status = 5;
}

message ScoreboardState {
string decision_id = 1;
oneof trust_score_result {
double trust_score = 2;
TrustScoreStatus insufficient_reason = 3;
}
string policy_verdict = 4;
repeated MetricEntry metrics = 5;
string merkle_root_ref = 6;
int64 rebuilt_at_unix_ms = 7;
int64 merkle_timestamp_unix_ms = 8;  // 0 if merkle_root_ref is unset; added
// alongside the runtime_context/Struct change after noticing domain.models
// grew this field but the proto contract was never updated to match.
}

message GetMerkleProofRequest {
string decision_id = 1;
string metric_name = 2;
}

message ProofNode {
enum Position {
POSITION_UNSPECIFIED = 0;
LEFT = 1;
RIGHT = 2;
}
bytes hash = 1;
Position position = 2;
}

message MerkleProof {
bytes leaf_hash = 1;
repeated ProofNode proof_path = 2;
bytes root = 3;
bytes anchor_signature = 4;          // Ed25519
int64 anchor_timestamp_unix_ms = 5;  // RFC 3161 / pluggable TSA
}




#models.py

"""
Core domain models. Spec v1.2 section 1.4 (data model), section 1.7 (contracts).

These are the Pydantic v2 models used INSIDE the Core (persisted / returned by
GetScoreboard, GetMerkleProof). They are distinct from api/schemas.py, which are
the wire-level request/response shapes for the REST layer (hexagonal boundary:
API schemas may evolve independently of domain models).
"""
from **future** import annotations

import datetime as dt
from typing import Any

from pydantic import BaseModel, Field, JsonValue, field_validator

from domain.enums import MetricStatus, PolicyVerdict as PolicyVerdictEnum, ProofPosition

class EvidenceRecord(BaseModel):
"""Evidence Registry entry. Never stores raw personal data (Assumption 6) —
only a content hash and a storage reference (WORM, localized storage)."""
evidence_id: str
decision_id: str
source_type: str  # RAG_DOCUMENT | POLICY | EXTERNAL_API | MANUAL_UPLOAD
content_hash: str
storage_ref: str
fetched_at: dt.datetime
ttl_expires_at: dt.datetime | None = None

class MetricRecord(BaseModel):
"""Metrics Registry entry — one row per (decision_id, metric_name, idempotency_key).
Append-only: a new value for the same metric_name is a NEW record, never an
UPDATE of an existing one (invariant I7)."""

```
decision_id: str
metric_name: str
value: Any
proposed_by: str
idempotency_key: str
evidence_refs: list[str] = Field(default_factory=list)
status: MetricStatus = MetricStatus.PROPOSED
created_at: dt.datetime
leaf_hash: str | None = Field(default=None, pattern=r"^[a-f0-9]{64}$")  # hex SHA-256, set only when status == COMMITTED
runtime_context: JsonValue = Field(default_factory=dict)  # opaque, spec 1.4
superseded_by: str | None = None  # idempotency_key of the superseding record, if any

@field_validator("evidence_refs")
@classmethod
def _sorted_unique(cls, v: list[str]) -> list[str]:
    # Leaf hash formula requires evidence_refs_sorted — normalize at the model
    # boundary so every downstream consumer sees the canonical order.
    return sorted(set(v))
```

class RiskSignalEntry(BaseModel):
decision_id: str
metric_name: str
category: str
severity: float = Field(ge=0.0, le=1.0)
status: str = "ACTIVE"  # ACTIVE | RESOLVED
resolved_by: str | None = None
resolved_at: dt.datetime | None = None
contradiction_flags: list[str] = Field(default_factory=list)

class ScoreboardMetricView(BaseModel):
value: Any
evidence_refs: list[str]
committed_at: dt.datetime
status: MetricStatus

class ScoreboardState(BaseModel):
"""Scoreboard Core — CQRS read projection. NOT the source of truth; it is
rebuilt deterministically from the append-only event log (I2, I7)."""

```
decision_id: str
trust_score: float | None = None  # None == INSUFFICIENT_DATA (I4)
policy_verdict: PolicyVerdictEnum = PolicyVerdictEnum.INSUFFICIENT_DATA
metrics: dict[str, ScoreboardMetricView] = Field(default_factory=dict)
merkle_root_ref: str | None = None
merkle_timestamp: dt.datetime | None = None  # when merkle_root_ref was anchored (TSA time)
rebuilt_at: dt.datetime
rebuild_seq: int
```

class ProofNode(BaseModel):
hash: str
position: ProofPosition

class MerkleProofResponse(BaseModel):
leaf_hash: str
proof_path: list[ProofNode]
root: str
anchor_signature: str
anchor_timestamp: dt.datetime

class PolicyVerdictResult(BaseModel):
trust_score: float | None
